# Server
PORT=5000

# NeonDB — get from https://console.neon.tech → Connection string
# Use the "pooled" connection string for production
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/warka_db?sslmode=require

# Keep these if you want individual fields instead of DATABASE_URL
DB_HOST=ep-xxx.us-east-1.aws.neon.tech
DB_PORT=5432
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password
DB_NAME=warka_db

# Auth
JWT_SECRET=your_very_long_random_secret_here

# CORS — your Vercel frontend URL
CLIENT_URL=https://your-app.vercel.app
