# Local API server
NODE_ENV=development
PORT=5000

# Use DATABASE_URL or the individual DB_* values below.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_database_password
DB_NAME=warka_db

# Generate a unique secret for each environment (for example: openssl rand -hex 32).
JWT_SECRET=replace_with_a_long_random_secret

# Google Identity Services Web OAuth client ID (use the same ID in client/.env)
GOOGLE_CLIENT_ID=181033328239-fpqurruvqapfc2afnf87iv3b1m378dgi.apps.googleusercontent.com

# Exact email allowed to view the admin user-count dashboard
ADMIN_EMAIL=wubet453@gmail.com

# Frontend origin used by Socket.IO in local development.
CLIENT_URL=http://localhost:5173

# Optional. Defaults to server/uploads when unset.
# UPLOADS_DIR=/path/to/persistent/uploads
